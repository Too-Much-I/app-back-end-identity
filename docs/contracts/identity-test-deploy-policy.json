{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {
      "Sid": "IdentityImageBuild", "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage"],
      "Resource": "arn:aws:ecr:ap-northeast-2:889384901776:repository/tosunsaeng-identity"
    },
    {
      "Sid": "TaskDefinitionApi", "Effect": "Allow",
      "Action": ["ecs:DescribeTaskDefinition", "ecs:RegisterTaskDefinition"], "Resource": "*"
    },
    {
      "Sid": "UpdateOnlyTestService", "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": "arn:aws:ecs:ap-northeast-2:889384901776:service/tosunsaeng-staging-cluster/tosunsaeng-identity-test-service"
    },
    {
      "Sid": "PassOnlyTestExecutionRole", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::889384901776:role/tosunsaeng-identity-test-execution-role",
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    }
  ]
}
