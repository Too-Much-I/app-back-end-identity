MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=to-teacher-identity
SERVER_PORT=8081
SWAGGER_ENABLED=true
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
PRIVACY_CONSENT_VERSION=privacy-v1
TERM_CONSENT_VERSION=term-v1
QUALITY_REVIEW_CONSENT_VERSION=quality-review-v1
REFRESH_TOKEN_TTL=P14D
REFRESH_TOKEN_RANDOM_BYTES=32
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=tosunsaeng-learning-core
JWT_KEY_ID=tosunsaeng-identity-rsa-1
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_PRIVATE_KEY_LOCATION=file:.local/keys/private.pem
JWT_PUBLIC_KEY_LOCATION=file:.local/keys/public.pem
JWT_PREVIOUS_KEY_IDS=
JWT_PREVIOUS_PUBLIC_KEY_LOCATIONS=
WORKLOAD_JWT_ENABLED=false
WORKLOAD_JWT_ISSUER=
WORKLOAD_JWT_SUBJECT=identity-service
WORKLOAD_JWT_TTL=PT2M
FIREBASE_AUTH_ENABLED=false
FIREBASE_WITHDRAWAL_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_TENANT_ID=
FIREBASE_GOOGLE_ENABLED=false
FIREBASE_APPLE_ENABLED=false
FIREBASE_KAKAO_ENABLED=false
FIREBASE_PHONE_ENABLED=false
FIREBASE_KAKAO_PROVIDER_ID=oidc.kakao
FIREBASE_LOGIN_MAX_AUTHENTICATION_AGE=PT15M
FIREBASE_HIGH_RISK_MAX_AUTHENTICATION_AGE=PT5M
FIREBASE_CLOCK_SKEW=PT30S
FIREBASE_CONNECT_TIMEOUT=PT3S
FIREBASE_READ_TIMEOUT=PT5S
FIREBASE_ENROLLMENT_TTL=PT10M
FIREBASE_ENROLLMENT_CLEANUP_RETENTION=PT24H
PHONE_IDENTITY_FINGERPRINT_ENABLED=false
PHONE_IDENTITY_FINGERPRINT_KEY_RING=
PHONE_ELIGIBILITY_BINDING_ENABLED=false
PHONE_ELIGIBILITY_BINDING_CONSUMER_SCOPE_ID=
PHONE_ELIGIBILITY_BINDING_KEY_RING=
PHONE_ELIGIBILITY_PUBLISHER_ENABLED=false
PHONE_ELIGIBILITY_PUBLISHER_BASE_URL=
PHONE_ELIGIBILITY_PUBLISHER_REGION=ap-northeast-2
PHONE_ELIGIBILITY_PUBLISHER_LEASE_DURATION=PT60S
PHONE_ELIGIBILITY_PUBLISHER_FIXED_DELAY=PT5S
PHONE_ELIGIBILITY_PUBLISHER_MAX_ATTEMPTS=12
PHONE_ELIGIBILITY_PUBLISHER_PUBLISHED_RETENTION=P30D
PHONE_ELIGIBILITY_PUBLISHER_DEAD_LETTER_REVIEW=P90D
PHONE_ELIGIBILITY_PUBLISHER_CONNECT_TIMEOUT=PT1S
PHONE_ELIGIBILITY_PUBLISHER_READ_TIMEOUT=PT3S
PHONE_ELIGIBILITY_PUBLISHER_MAX_BATCH_SIZE=20
OWNER_EVENT_USER_MERGED_CAPTURE_ENABLED=false
OWNER_EVENT_TRIAL_REBIND_CAPTURE_ENABLED=false
OWNER_EVENT_BILLING_USER_MERGED_PUBLISHER_ENABLED=false
OWNER_EVENT_LEARNING_CORE_USER_MERGED_PUBLISHER_ENABLED=false
OWNER_EVENT_BILLING_TRIAL_REBIND_PUBLISHER_ENABLED=false
OWNER_EVENT_BILLING_BASE_URL=
OWNER_EVENT_BILLING_REGION=ap-northeast-2
OWNER_EVENT_LEARNING_CORE_ENDPOINT=
OWNER_EVENT_LEASE_DURATION=PT60S
OWNER_EVENT_FIXED_DELAY=PT5S
OWNER_EVENT_INITIAL_BACKOFF=PT5S
OWNER_EVENT_MAX_BACKOFF=PT15M
OWNER_EVENT_MAX_ATTEMPTS=12
OWNER_EVENT_PUBLISHED_RETENTION=P30D
OWNER_EVENT_DEAD_LETTER_REVIEW=P90D
OWNER_EVENT_CONNECT_TIMEOUT=PT1S
OWNER_EVENT_READ_TIMEOUT=PT3S
OWNER_EVENT_MAX_BATCH_SIZE=20
USER_WITHDRAWN_PUBLISHER_ENABLED=false
USER_WITHDRAWN_PUBLISHER_ENDPOINT=
USER_WITHDRAWN_PUBLISHER_LEASE_DURATION=PT60S
USER_WITHDRAWN_PUBLISHER_FIXED_DELAY=PT5S
USER_WITHDRAWN_PUBLISHER_MAX_ATTEMPTS=12
USER_WITHDRAWN_PUBLISHER_PUBLISHED_RETENTION=P30D
USER_WITHDRAWN_PUBLISHER_DEAD_LETTER_REVIEW=P90D
USER_WITHDRAWN_PUBLISHER_CONNECT_TIMEOUT=PT3S
USER_WITHDRAWN_PUBLISHER_READ_TIMEOUT=PT5S
USER_WITHDRAWN_PUBLISHER_MAX_BATCH_SIZE=20
USER_WITHDRAWN_BACKFILL_ENABLED=false
USER_WITHDRAWN_BACKFILL_DRY_RUN=true
USER_WITHDRAWN_BACKFILL_LOWER_BOUND=
USER_WITHDRAWN_BACKFILL_UPPER_BOUND=
USER_WITHDRAWN_BACKFILL_BATCH_LIMIT=20

# TMI-192: existing Firebase project/SMS/Admin credentials; no phone-based member login.
# Independent secret ring: version:base64-key[,retained-version:base64-key]. Each key >=32 random bytes.
# Provision through a secret manager. Retain old keys for >=24h after all old instances stop.
ACCOUNT_RECOVERY_ENABLED=false
ACCOUNT_RECOVERY_KEY_RING=
ACCOUNT_RECOVERY_CHALLENGE_TTL=PT5M
ACCOUNT_RECOVERY_RECENT_AUTH=PT5M
ACCOUNT_RECOVERY_RETRY_TTL=PT5M
ACCOUNT_RECOVERY_PREPARE_PER_MINUTE=10
ACCOUNT_RECOVERY_LOOKUP_PER_MINUTE=20
ACCOUNT_RECOVERY_PROOF_PER_QUARTER_HOUR=5

# Merge progress: enable only after Learning Core commit/duplicate 204 E2E.
OWNER_EVENT_MERGE_PROGRESS_CAPTURE_ENABLED=false
# Explicit when enabled: LEARNING_CORE_ONLY or LEARNING_CORE_AND_BILLING
OWNER_EVENT_MERGE_COMPLETION_PROFILE=

# Latest released app version only (numeric major.minor.patch). Blank => platform query returns 503.
# Set after the version is available in the store; no force-update policy.
APP_ANDROID_LATEST_VERSION=
APP_IOS_LATEST_VERSION=
